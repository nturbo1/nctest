aclocal.m4

# Local m4 macro directory (populated by aclocal --install)
# Uncomment the line below ONLY if you vendor your m4 macros into the repo.
# Otherwise, aclocal regenerates this directory and it should be ignored.
m4/

# If you DO vendor m4 macros (i.e., you want to track m4/ in git), comment
# the line above and uncomment the two lines below instead:
# !m4/
# m4/libtool.m4
# m4/ltoptions.m4
# m4/ltsugar.m4
# m4/ltversion.m4
# m4/lt~obsolete.m4


